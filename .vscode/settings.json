{
  "gradle.autoDetect": "off",
  "gradle.nestedProjects": [
    "android"
  ],
  "files.exclude": {
    "**/.gradle": true,
    "**/.kotlin": true,
    "**/.cxx": true,
    "**/build": true,
    "**/node_modules": true,
    "dist": true
  },
  "search.exclude": {
    "**/.gradle": true,
    "**/.kotlin": true,
    "**/.cxx": true,
    "**/build": true,
    "**/node_modules": true,
    "dist": true
  },
  "files.watcherExclude": {
    "**/.gradle/**": true,
    "**/.kotlin/**": true,
    "**/.cxx/**": true,
    "**/build/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true
  },
  "chatgpt.commentCodeLensEnabled": true
}
